NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://langkahsiswa:langkahsiswa_dev@localhost:5432/langkahsiswa
DATABASE_URL_DOCKER=postgresql://langkahsiswa:langkahsiswa_dev@postgres:5432/langkahsiswa
POSTGRES_USER=langkahsiswa
POSTGRES_PASSWORD=langkahsiswa_dev
POSTGRES_DB=langkahsiswa
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
ALLOW_TENANT_HEADER=true
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=langkahsiswa
MINIO_SECRET_KEY=langkahsiswa_dev_secret
MINIO_BUCKET=langkahsiswa
BASE_DOMAIN=langkahsiswa.id
CUSTOM_DOMAIN_CNAME_TARGET=domains.langkahsiswa.id
CUSTOM_DOMAIN_AUTO_SSL=false
LIBRARY_DAILY_PENALTY=1000
MINIO_REGION=us-east-1
SEED_ADMIN_EMAIL=admin@demo.langkahsiswa.id
SEED_ADMIN_PASSWORD=LangkahSiswa!2026

# Google Identity Services web OAuth client ID; first ID is used by the web UI.
# Comma-separated IDs allowed for additional trusted native clients.
GOOGLE_CLIENT_ID=

# `filesystem` for local development/tests; Docker overrides this with `minio`.
STORAGE_DRIVER=filesystem
# Private fallback storage and backward-compatible payment proof volume.
STORAGE_PATH=.local/uploads

# Firebase Cloud Messaging HTTP v1. Keep service-account credentials private.
# Set either path to a service-account JSON or private JSON environment value.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
NOTIFICATION_WORKER_ENABLED=true
