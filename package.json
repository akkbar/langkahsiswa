{
  "name": "schoolapp",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k -n api,admin,website \"npm run dev -w @schoolapp/api\" \"npm run dev -w @schoolapp/admin\" \"npm run dev -w @schoolapp/website\"",
    "build": "npm run build -w @schoolapp/api && npm run build -w @schoolapp/admin && npm run build -w @schoolapp/website",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/admin/tsconfig.json --noEmit && tsc -p apps/website/tsconfig.json --noEmit",
    "db:migrate": "tsx apps/api/scripts/migrate.ts",
    "db:seed": "tsx apps/api/scripts/seed.ts",
    "test": "tsx --test apps/api/test/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 apps/api/test/integration/*.test.ts",
    "test:ui": "playwright test",
    "platform:admin": "tsx apps/api/scripts/platform-admin.ts",
    "format": "prettier --write \"apps/*/src/**/*.{ts,tsx,css}\" \"apps/api/{scripts,test}/**/*.ts\" \"packages/*/src/**/*.ts\"",
    "format:check": "prettier --check \"apps/*/src/**/*.{ts,tsx,css}\" \"apps/api/{scripts,test}/**/*.ts\" \"packages/*/src/**/*.ts\""
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.15.0",
    "concurrently": "^9.1.2",
    "prettier": "^3.9.6",
    "tsx": "^4.19.3",
    "typescript": "~5.8.3"
  },
  "overrides": {
    "@nestjs/platform-express@11.2.3": {
      "multer": "2.3.0"
    }
  }
}
